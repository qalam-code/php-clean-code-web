{
    "name": "qalam-code/php-clean-code-skeleton",
    "description": "Squelette de projet bati sur php-clean-code.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.0",
        "ext-json": "*",
        "ext-pdo": "*",
        "qalam-code/php-clean-code": "^0.1"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/qalam-code/phpCleanCode"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\Exemple\\": "src/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}

